    },
    {
      "id": "U4xSkCB9f1WTpO4z37ksP",
      "type": "text",
      "x": 318.58984375,
      "y": 492.4765625,
      "width": 571.6397094726562,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 1999058394,
      "version": 192,
      "versionNonce": 1086674887,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1771473079634,
      "link": null,
      "locked": false,
      "text": "Estimation\nDAU - 1 million\nso lets calculate the db size\n- avg message size is 5 kb\n- QPS = 1*10^6/24*3600 = 12.5\n-- db size - 12.5*5*3600*24*30*5*10^3 =810*10^9 ~ 1TB\n\n\nHLD \n\n  ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Estimation\nDAU - 1 million\nso lets calculate the db size\n- avg message size is 5 kb\n- QPS = 1*10^6/24*3600 = 12.5\n-- db size - 12.5*5*3600*24*30*5*10^3 =810*10^9 ~ 1TB\n\n\nHLD \n\n  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rQHQK77-0EnpCJj458Hhf",
      "type": "text",
      "x": 323.3125,
      "y": 116.32421875,
      "width": 195.8199005126953,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
