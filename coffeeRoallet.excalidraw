      "updated": 1771473079634,
      "link": null,
      "locked": false,
      "text": "Design Whatsapp\n\nFunctional Requiremnt -\n1. can send message\n2. read message\n3. check online user\n4. ensure message delivery\n5. Read receipt\n6. one to one message\n7. One to many message\n8. only one delivery\n9. can send text and media\n\n",
      "fontSize": 20.105468749999975,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Design Whatsapp\n\nFunctional Requiremnt -\n1. can send message\n2. read message\n3. check online user\n4. ensure message delivery\n5. Read receipt\n6. one to one message\n7. One to many message\n8. only one delivery\n9. can send text and media\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
