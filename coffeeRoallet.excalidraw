    {
      "id": "n8xBRiuXZpO5wAhfswKP1",
      "type": "text",
      "x": 665.5772705078125,
      "y": 199.17578125,
      "width": 265.079833984375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
